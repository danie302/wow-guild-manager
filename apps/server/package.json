{
  "name": "@wgm/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migration:create": "sequelize-cli migration:generate",
    "dev:api": "sequelize-cli db:migrate && tsx watch --include src --include ../../packages/shared/src src/entrypoints/api.ts",
    "dev:bot": "tsx watch --include src --include ../../packages/shared/src src/entrypoints/bot.ts",
    "dev:worker": "tsx watch --include src --include ../../packages/shared/src src/entrypoints/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@wgm/shared": "workspace:*",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
