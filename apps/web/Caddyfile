# Production web server (apps/web/Dockerfile). docker-compose.prod.yml sets SITE_ADDRESS to
# APP_DOMAIN, so Caddy gets and renews the HTTPS certificate and redirects HTTP to HTTPS.
# docker-compose.tunnel.yml sets it to http://APP_DOMAIN instead: Cloudflare Tunnel handles
# HTTPS, and Caddy trusts its X-Forwarded-Proto header (TRUSTED_PROXIES) so the API still
# sees HTTPS and sends secure cookies.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# The API, on the same origin, so the browser needs no CORS and the session cookie works.
	handle /api/* {
		reverse_proxy api:3000
	}

	# The web app. Client-side routes (e.g. /guilds/…/events) get index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Vite puts a content hash in asset names, so they can be cached for good.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"
}
