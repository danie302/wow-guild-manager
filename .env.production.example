# Production settings for docker-compose.prod.yml. On the server:
#   cp .env.production.example .env   # then fill in every value
# See docs/deployment.md.

# The domain people open, without https:// (e.g. guild.example.com). Its DNS A record must point
# at the server. Caddy gets the HTTPS certificate for it, and Discord's login comes back to
# https://<APP_DOMAIN>/api/auth/discord/callback.
APP_DOMAIN=

# PostgreSQL. The database isn't reachable from outside the server, but use a strong password:
# openssl rand -hex 24
POSTGRES_USER=wgm
POSTGRES_PASSWORD=
POSTGRES_DB=wgm

# Signs the session cookie. Changing it logs everyone out: openssl rand -base64 48
SESSION_SECRET=

# Your Discord application (Developer Portal): the bot token (Bot > Reset Token) and the
# OAuth2 credentials (OAuth2). See "Set up Discord" in README.md.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Only with docker-compose.tunnel.yml (a server without a public IP, e.g. a home PC): the
# token of your Cloudflare Tunnel. See "Run it on a home PC" in docs/deployment.md.
CLOUDFLARE_TUNNEL_TOKEN=

# fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# The daily database backup: the hour it runs (UTC), and how many days of backups to keep.
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=7
