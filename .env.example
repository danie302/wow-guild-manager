# Copy this file to .env before running `docker compose up`.

# PostgreSQL user that the postgres container creates and the server connects as.
POSTGRES_USER=wgm
# Password for POSTGRES_USER. Only used locally; change it if you expose the database.
POSTGRES_PASSWORD=wgm
# Name of the database the postgres container creates.
POSTGRES_DB=wgm

# Token of your Discord application's bot (Developer Portal > your app > Bot > Reset Token).
# Required by the bot container; the worker uses it for direct messages. See "Set up Discord" in README.md.
DISCORD_BOT_TOKEN=

# OAuth2 credentials of the same Discord application (Developer Portal > your app > OAuth2).
# Needed to log in to the web app; without them the API runs with login turned off.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Signs the web session cookie. Any random string of 32+ characters; changing it logs everyone out.
# Generate a new one for any shared or public deployment: openssl rand -base64 48
SESSION_SECRET=local-development-only-session-secret-change-me

# Log level for api, bot, and worker: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Ports published on your machine. Change one if it's already in use locally.
# Web app (Vite dev server).
WEB_PORT=5173
# Express API.
API_PORT=3000
# PostgreSQL, for database tools on your machine.
POSTGRES_PORT=5432
# Redis, for Redis tools on your machine.
REDIS_PORT=6379
