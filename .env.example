# Copy this file to .env before running `docker compose up`.

# PostgreSQL user that the postgres container creates and the server connects as.
POSTGRES_USER=wgm
# Password for POSTGRES_USER. Only used locally; change it if you expose the database.
POSTGRES_PASSWORD=wgm
# Name of the database the postgres container creates.
POSTGRES_DB=wgm

# Ports published on your machine. Change one if it's already in use locally.
# Web app (Vite dev server).
WEB_PORT=5173
# Express API.
API_PORT=3000
# PostgreSQL, for database tools on your machine.
POSTGRES_PORT=5432
# Redis, for Redis tools on your machine.
REDIS_PORT=6379
